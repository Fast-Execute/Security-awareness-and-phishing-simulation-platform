NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server/edge functions only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function secrets (configure in Supabase Dashboard > Edge Functions > Secrets).
CAMPAIGN_CRON_SECRET=
RESEND_API_KEY=
# Must be an address on the same verified domain selected by the campaign.
SIMULATION_FROM_EMAIL=awareness@example.com
# Hard caps: per invocation 1-50 recipients; pacing 500-5000ms between sends.
CAMPAIGN_MAX_PER_RUN=20
CAMPAIGN_SEND_INTERVAL_MS=1000

APP_BASE_URL=http://localhost:3000
